generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApplicationSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("application_settings")
}

model GoldProduct {
  id                 String      @id @default(cuid())
  code               String      @unique
  name               String
  purity             Decimal     @db.Decimal(5, 2)
  sourceProductCode  String      @map("source_product_code")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")
  prices             GoldPrice[]
  transactions       GoldTransaction[]
  buyPlans           BuyPlan[]

  @@map("gold_products")
}

enum BuyPlanLevelStatus {
  WAITING
  TRIGGERED
  EXECUTED
  CANCELLED
}

enum AlertDeliveryStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

model BuyPlan {
  id        String         @id @default(cuid())
  name      String
  productId String         @map("product_id")
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  product   GoldProduct    @relation(fields: [productId], references: [id], onDelete: Restrict)
  levels    BuyPlanLevel[]

  @@index([productId])
  @@index([isActive, createdAt(sort: Desc)])
  @@map("buy_plans")
}

model BuyPlanLevel {
  id                String             @id @default(cuid())
  buyPlanId         String             @map("buy_plan_id")
  targetPrice       Decimal            @map("target_price") @db.Decimal(12, 2)
  investmentAmount  Decimal            @map("investment_amount") @db.Decimal(14, 2)
  sequence          Int
  status            BuyPlanLevelStatus @default(WAITING)
  triggeredAt       DateTime?          @map("triggered_at")
  executedAt        DateTime?          @map("executed_at")
  cancelledAt       DateTime?          @map("cancelled_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  buyPlan           BuyPlan            @relation(fields: [buyPlanId], references: [id], onDelete: Cascade)
  alertEvents       AlertEvent[]

  @@unique([buyPlanId, sequence])
  @@index([buyPlanId])
  @@index([status, targetPrice])
  @@map("buy_plan_levels")
}

model AlertEvent {
  id             String              @id @default(cuid())
  buyPlanLevelId String              @map("buy_plan_level_id")
  observedPrice  Decimal             @map("observed_price") @db.Decimal(12, 2)
  message        String
  deliveryStatus AlertDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveryError  String?             @map("delivery_error")
  triggeredAt    DateTime            @default(now()) @map("triggered_at")
  buyPlanLevel   BuyPlanLevel        @relation(fields: [buyPlanLevelId], references: [id], onDelete: Cascade)

  @@index([buyPlanLevelId])
  @@index([triggeredAt(sort: Desc)])
  @@map("alert_events")
}

model GoldTransaction {
  id               String      @id @default(cuid())
  productId        String      @map("product_id")
  purchasedAt      DateTime    @map("purchased_at")
  purchasePrice    Decimal     @map("purchase_price") @db.Decimal(12, 2)
  investmentAmount Decimal     @map("investment_amount") @db.Decimal(14, 2)
  goldWeight       Decimal     @map("gold_weight") @db.Decimal(14, 6)
  fee              Decimal     @default(0) @db.Decimal(12, 2)
  notes            String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  product          GoldProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  sales            GoldSale[]

  @@index([productId])
  @@index([purchasedAt(sort: Desc)])
  @@map("gold_transactions")
}

model GoldSale {
  id                    String          @id @default(cuid())
  purchaseTransactionId String          @map("purchase_transaction_id")
  soldAt                DateTime        @map("sold_at")
  salePrice             Decimal         @map("sale_price") @db.Decimal(12, 2)
  goldWeight            Decimal         @map("gold_weight") @db.Decimal(14, 6)
  fee                   Decimal         @default(0) @db.Decimal(12, 2)
  notes                 String?
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  purchaseTransaction   GoldTransaction @relation(fields: [purchaseTransactionId], references: [id], onDelete: Restrict)

  @@index([purchaseTransactionId, soldAt(sort: Desc)])
  @@index([soldAt(sort: Desc)])
  @@map("gold_sales")
}

model GoldPrice {
  id                String      @id @default(cuid())
  productId         String      @map("product_id")
  buyPrice          Decimal     @map("buy_price") @db.Decimal(12, 2)
  sellPrice         Decimal     @map("sell_price") @db.Decimal(12, 2)
  buyChange         Decimal?    @map("buy_change") @db.Decimal(12, 2)
  sellChange        Decimal?    @map("sell_change") @db.Decimal(12, 2)
  source            String
  sourceUpdatedAt   DateTime    @map("source_updated_at")
  fetchedAt         DateTime    @default(now()) @map("fetched_at")
  rawResponseHash   String      @map("raw_response_hash")
  product           GoldProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([productId, rawResponseHash])
  @@index([productId, sourceUpdatedAt(sort: Desc)])
  @@index([sourceUpdatedAt(sort: Desc)])
  @@map("gold_prices")
}

model NewsArticle {
  id           String   @id @default(cuid())
  source       String
  externalId   String   @map("external_id")
  canonicalUrl String   @map("canonical_url")
  urlHash      String   @unique @map("url_hash")
  title        String
  excerpt      String?
  sourceTier   String   @default("PRIMARY") @map("source_tier")
  publishedAt  DateTime @map("published_at")
  fetchedAt    DateTime @default(now()) @map("fetched_at")
  rawHash      String                @map("raw_hash")
  briefEvidence MarketBriefEvidence[]

  @@unique([source, externalId])
  @@index([publishedAt(sort: Desc)])
  @@index([source, publishedAt(sort: Desc)])
  @@map("news_articles")
}

enum MarketBriefStance {
  BULLISH
  NEUTRAL
  BEARISH
}

model MarketBrief {
  id             String                 @id @default(cuid())
  generatedAt    DateTime               @default(now()) @map("generated_at")
  windowStart    DateTime               @map("window_start")
  windowEnd      DateTime               @map("window_end")
  stance         MarketBriefStance
  confidence     Decimal                @db.Decimal(4, 3)
  summary        String
  bullishFactors Json                   @map("bullish_factors")
  bearishFactors Json                   @map("bearish_factors")
  riskFlags      Json                   @map("risk_flags")
  unknowns       Json
  provider       String
  model          String
  promptVersion  String                 @map("prompt_version")
  responseId     String?                @map("response_id")
  expiresAt      DateTime               @map("expires_at")
  evidence       MarketBriefEvidence[]

  @@index([generatedAt(sort: Desc)])
  @@index([expiresAt])
  @@map("market_briefs")
}

model MarketBriefEvidence {
  briefId   String      @map("brief_id")
  articleId String      @map("article_id")
  brief     MarketBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  article   NewsArticle @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@id([briefId, articleId])
  @@index([articleId])
  @@map("market_brief_evidence")
}
