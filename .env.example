# Runtime
NODE_ENV=development
LOG_LEVEL=info

# API
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=120

# Frontend (server-side URL used by Next.js)
GOLDIQ_API_URL=http://localhost:4000/api/v1

# PostgreSQL
POSTGRES_DB=goldiq
POSTGRES_USER=goldiq
POSTGRES_PASSWORD=change-me-for-non-local-use
DATABASE_URL=postgresql://goldiq:change-me-for-non-local-use@localhost:5432/goldiq?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Hua Seng Heng integration scaffold (mock by default in local development)
HSH_PRICE_965_URL=http://localhost:4010/api/values/getprice/
HSH_PRICE_9999_URL=http://localhost:4010/api/values
HSH_API_TOKEN=
HSH_REQUEST_TIMEOUT_MS=5000
HSH_REQUEST_MAX_RETRIES=3
HSH_RETRY_BASE_DELAY_MS=250
HSH_POLL_CRON=*/1 * * * *
HSH_SCHEDULER_ENABLED=true
GOLD_PRICE_REFRESH_LOCK_TTL_MS=50000
GOLD_PRICE_HISTORY_DEFAULT_LIMIT=100
GOLD_PRICE_HISTORY_MAX_LIMIT=500
BUY_PLAN_ALERT_CRON=*/30 * * * * *
BUY_PLAN_ALERTS_ENABLED=true
BUY_PLAN_ALERT_LOCK_TTL_MS=25000

# Notification providers — keep real values outside source control
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Local mock
MOCK_HSH_PORT=4010
